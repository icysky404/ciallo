#pragma once

#cmakedefine CIALLO_SHARED_LIBRARY

#if defined(CIALLO_SHARED_LIBRARY)
#    if defined(_WIN32) || defined(_WIN64) || defined(__CYGWIN__)
#        if defined(CIALLO_BUILD_SHARED_LIBRARY)
#            define CIALLO_API __declspec(dllexport)
#        else
#            define CIALLO_API __declspec(dllimport)
#        endif
#    else
#        define CIALLO_API __attribute__((visibility("default")))
#    endif
#else
#    define CIALLO_API
#endif
